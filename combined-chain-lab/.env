# Copy to `.env` and adjust for your local model server:  cp .env.example .env

# OpenAI-compatible endpoint. For Ollama on the host, keep the /v1 suffix.
LLM_BASE_URL=http://100.64.138.60:11434/v1
# Ollama ignores this, but the OpenAI SDK requires a non-empty value.
LLM_API_KEY=ollama
LLM_TIMEOUT=180
# Sampling temperature. MUST be > 0: at 0 this Ollama model deterministically locks onto a
# refusal (or emits an empty turn) for the escalation steps and never calls the tool.
LLM_TEMPERATURE=0.7

# Models must support tool / function calling. This lab is multi-turn and tool-heavy, so
# prefer a solid function-calling model. qwen3.5:9b is a good default; llama3.2 also works.
FRONTEND_MODEL=rafw007/gemma4-e4b-claude-coder:latest
BACKEND_MODEL=rafw007/gemma4-e4b-claude-coder:latest

# Support MCP server (Streamable HTTP). Leave as-is for the default compose network.
MCP_SERVER_URL=http://mcp-server:8001/mcp

# Shared HMAC signing key for session tokens (used by the MCP server AND the signer).
# It is INTENTIONALLY leaked by status(verbose=True) -- that leak is objective 1.
SIGNING_KEY=helix-signing-key-2026
# Internal signer endpoint. Reachable only over the lab network (no host port).
SIGNER_URL=http://signer:9003/sign
# Session-token lifetime (seconds). Generous 2h so a real human-paced solve never expires a
# token mid-chain. Tokens stay forgeable regardless -- that is the whole point of the lab.
TOKEN_TTL=7200

# The four staged objectives. Checked by /api/verify; never given to either LLM.
# FLAG4 is also baked into /root/flag.txt in the mcp-server image at build time.
FLAG1=FLAG{CHAIN_STATUS_INFO_DISCLOSURE}
FLAG2=FLAG{CHAIN_SIGNER_PRIVILEGE_ESCALATION}
FLAG3=FLAG{CHAIN_ADMIN_BOLA_CONFUSED_DEPUTY}
FLAG4=FLAG{CHAIN_ADMIN_RCE_COMMAND_INJECTION}

# Host ports are remapped (3100/8100/8101) so this lab can run alongside the three source
# labs without collisions. The browser UI is at http://localhost:3100.

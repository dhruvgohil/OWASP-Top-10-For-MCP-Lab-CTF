# Copy to .env and adjust. All values have safe defaults for local lab use.

# --- Flag values (must match the running combined-chain-lab) -----------------
FLAG1=FLAG{CHAIN_STATUS_INFO_DISCLOSURE}
FLAG2=FLAG{CHAIN_SIGNER_PRIVILEGE_ESCALATION}
FLAG3=FLAG{CHAIN_ADMIN_BOLA_CONFUSED_DEPUTY}
FLAG4=FLAG{CHAIN_ADMIN_RCE_COMMAND_INJECTION}

# --- Security ----------------------------------------------------------------
# Long random string. Keep it stable so login sessions survive a restart.
#   e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-please-set-a-long-random-secret

# Set to 1 only when the dashboard is served over HTTPS (marks the session
# cookie Secure). Leave 0 for http://localhost.
COOKIE_SECURE=0

# Only addresses in exactly this domain may register. Subdomains do NOT count
# (mail.gmail.com is rejected). Addresses are never emailed — a fake one
# like test@gmail.com is fine.
ALLOWED_EMAIL_DOMAIN=gmail.com

# --- Misc --------------------------------------------------------------------
# Where the "Open the lab" button points.
LAB_URL=http://localhost:3100
